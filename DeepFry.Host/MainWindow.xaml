<Window x:Class="DeepFry.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Fry v3.3.1"
        Icon="pack://application:,,,/DeepFry.Host;component/DeepFry.ico"
        Width="1050"
        Height="650"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Button Content="Lab Settings"
                    Click="LabSettings_Click"
                    DockPanel.Dock="Right"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button Content="Settings"
                    Click="Settings_Click"
                    DockPanel.Dock="Right"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/DeepFry.Host;component/favicon.png"
                       Width="56"
                       Height="56"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel>
                    <TextBlock Text="Deep Fry - UPT LAB Amikom Yogyakarta"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock Text="© 2025 Gusti Padaka | NIM 22.11.5020 | Universitas Amikom Yogyakarta"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText"
                               Margin="0,5,0,0"
                               Text="Starting..."
                               Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <WrapPanel Grid.Row="2">
            <Button Content="Refresh UWF Status"
                    Click="RefreshUwfStatus_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button Content="Lock Selected"
                    Click="LockSelected_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button Content="Unlock Selected"
                    Click="UnlockSelected_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button x:Name="RestartSelectedButton"
                    Content="Restart Selected"
                    Click="RestartSelected_Click"
                    Padding="12,6"/>
        </WrapPanel>

        <DataGrid x:Name="ClientGrid"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  RowHeaderWidth="0"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="42">
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="SelectAllCheckBox"
                                  Checked="SelectAllCheckBox_Checked"
                                  Unchecked="SelectAllCheckBox_Unchecked"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Computer" Binding="{Binding Hostname}" IsReadOnly="True" Width="1.4*"/>
                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" IsReadOnly="True" Width="0.9*"/>
                <DataGridTextColumn Header="Connection" Binding="{Binding Status}" IsReadOnly="True" Width="0.7*"/>
                <DataGridTextColumn Header="Filter (Current)" Binding="{Binding UwfStatusText}" IsReadOnly="True" Width="0.9*"/>
                <DataGridTextColumn Header="Filter (Next)" Binding="{Binding UwfStatusAfterRestartText}" IsReadOnly="True" Width="0.9*"/>
                <DataGridTemplateColumn Header="Last Result" IsReadOnly="True" MinWidth="240" Width="2.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LastResult}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Margin="4,3"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
